---
import Base from '../../layouts/Base.astro';
---

<Base title="纸城 — Outside the Blue" current="作品">
	<div class="project-bg" style="background-image: url('/cover-outside-the-blue.png');"></div>

	<article class="project">
		<a href="/works" class="project__back">← 作品</a>

		<header class="project__head">
			<div class="eyebrow project__eyebrow">P02 · UAL · 2025</div>
			<h1 class="project__title">Outside the Blue</h1>
			<p class="project__subtitle">太空生存 · 资源管理</p>
		</header>

		<div class="project__video">
			<iframe
				src="//player.bilibili.com/player.html?bvid=BV1gtLL6PEun&page=1&danmaku=0&high_quality=1"
				scrolling="no"
				frameborder="0"
				allowfullscreen
			></iframe>
		</div>

		<div class="project__body">
			<p class="project__placeholder">正文内容稍后补充</p>
		</div>

		<footer class="project__foot">
			<a href="/works" class="project__back">← 返回作品列表</a>
		</footer>
	</article>
</Base>
