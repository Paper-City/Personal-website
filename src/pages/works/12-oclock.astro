---
import Base from '../../layouts/Base.astro';
---

<Base title="纸城 — 12Oclock" current="作品">
	<div class="project-bg" style="background-image: url('/midnight.png');"></div>

	<article class="project">
		<a href="/works" class="project__back">← 作品</a>

		<header class="project__head">
			<div class="eyebrow project__eyebrow">P06 · UAL · 2025</div>
			<h1 class="project__title">12Oclock</h1>
			<p class="project__subtitle">待补充</p>
		</header>

		<div class="project__video">
			<iframe
				src="//player.bilibili.com/player.html?bvid=BV1vtLH6tEZo&page=1&danmaku=0&high_quality=1"
				scrolling="no"
				frameborder="0"
				allowfullscreen
			></iframe>
		</div>

		<div class="project__body">
			<p class="project__placeholder">内容稍后补充</p>
		</div>

		<footer class="project__foot">
			<a href="/works" class="project__back">← 返回作品列表</a>
		</footer>
	</article>
</Base>
