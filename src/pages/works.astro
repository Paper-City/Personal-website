---
import Base from '../layouts/Base.astro';

// Project tiles for the album.
// Each tile occupies a grid area defined in CSS via the `area` field.
// `cover` is a public image path; if absent, render a solid color block.
const projects = [
	{
		num: 'P03',
		title: 'Ash of Aetharn',
		subtitle: 'RTS · 肉鸽 · AI 协同开发',
		year: '进行中',
		cover: '/ash.webp',
		area: 'ash',
		href: '/works/ash-of-aetharn',
	},
	{
		num: 'P04',
		title: 'Boatwright',
		subtitle: '双人协同 · 单按键',
		year: 'UAL · 2026',
		cover: '/boat-wright-2.webp',
		area: 'boat',
		href: '/works/boatwright',
	},
	{
		num: 'P05',
		title: '矮人矿工',
		subtitle: '卡牌 · 随机性 · 连锁反应',
		year: '进行中',
		cover: '/miner.webp',
		area: 'sf',
		href: '/works/dwarf-miner',
	},
	{
		num: 'P06',
		title: '12Oclock',
		subtitle: '类幸存者 · 主动心流调节',
		year: 'UAL · 2025',
		cover: '/midnight.webp',
		area: 'p1',
		href: '/works/12-oclock',
	},
	{
		num: 'P07',
		title: 'DebugMyLife',
		subtitle: '平台跳跃 · 解谜',
		year: 'TapTap2025',
		cover: '/debug.webp',
		area: 'p07',
		href: '/works/debug-my-life',
	},
	{
		num: 'P02',
		title: 'Outside the Blue',
		subtitle: '太空生存 · 资源管理',
		year: 'UAL · 2025',
		cover: '/cover-outside-the-blue.webp',
		area: 'otb',
		href: '/works/outside-the-blue',
	},
	{
		num: 'P01',
		title: 'Slow & Fast',
		subtitle: '卡牌圈地桌游',
		year: 'UAL · 2024',
		cover: '/slow-and-fast.jpg',
		area: 'p2',
		href: '/works/slow-and-fast',
	},
];

const placeholders: { area: string; fill: string; label: string }[] = [];

const tools = [
	{
		num: 'T01',
		title: '个人任务系统',
		subtitle: 'Claude Code × 飞书 × 妙搭 × GitHub',
		year: '2026 · 多端协同',
		cover: '/missionsystem-dashboard.webp',
		href: '/works/task-system',
	},
];
---

<Base title="纸城 — 作品" current="作品">
	<section class="works-hero">
		<div class="works-hero__inner">
			<div class="eyebrow fade-up fade-up--1">02 ─ 作品</div>
		</div>
	</section>

	<section class="album fade-up fade-up--4">
		{projects.map((p) => (
			<a href={p.href} class={`album__tile area-${p.area} ${p.cover ? '' : 'album__tile--solid'} ${p.fill ? `fill-${p.fill}` : ''}`}>
				{p.cover && <img src={p.cover} alt={p.title} loading="lazy" />}
				<div class="album__overlay">
					<div class="album__num">{p.num}</div>
					<div class="album__title">{p.title}</div>
					<div class="album__sub">{p.subtitle}</div>
					<div class="album__year">{p.year}</div>
				</div>
			</a>
		))}

		{placeholders.map((p) => (
			<div class={`album__tile album__tile--coming area-${p.area} fill-${p.fill}`}>
				<div class="album__overlay">
					<div class="album__num">—</div>
					<div class="album__title album__title--coming">{p.label}</div>
				</div>
			</div>
		))}
	</section>

	<section class="tools-section fade-up fade-up--5">
		<div class="tools-section__head">
			<span class="eyebrow">工具 / Tools</span>
			<h2 class="tools-section__title">支撑我开发的 AI 协同工作流系统</h2>
		</div>
		<div class="tools-grid">
			{tools.map((t) => (
				<a href={t.href} class="tool-card">
					{t.cover && <img src={t.cover} alt={t.title} loading="lazy" class="tool-card__cover" />}
					<div class="tool-card__overlay">
						<div class="tool-card__num">{t.num}</div>
						<div class="tool-card__title">{t.title}</div>
						<div class="tool-card__sub">{t.subtitle}</div>
						<div class="tool-card__year">{t.year}</div>
					</div>
				</a>
			))}
		</div>
	</section>
</Base>

<style>
	.works-hero {
		padding-top: var(--s-4);
		padding-bottom: var(--s-3);
	}
	.works-hero__inner {
		max-width: 720px;
	}
	.works-hero .eyebrow {
		font-size: 18px;
	}

	/* ---------- Album Grid ---------- */
	.album {
		display: grid;
		grid-template-columns: 2fr 1.2fr 1.2fr;
		grid-template-rows: 320px 160px 180px 80px 260px;
		grid-template-areas:
			"ash    otb   sf"
			"ash    otb   p07"
			"boat   boat  p07"
			"boat   boat  p2"
			"p1     p1    p2";
		gap: 12px;
		margin-top: 18px;
	}

	.area-ash  { grid-area: ash; }
	.area-otb  { grid-area: otb; }
	.area-sf   { grid-area: sf; }
	.area-p1   { grid-area: p1; }
	.area-p2   { grid-area: p2; }
	.area-p07  { grid-area: p07; }
	.area-boat { grid-area: boat; }

	/* ---------- Tile ---------- */
	.album__tile {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--bg-soft);
		display: block;
		text-decoration: none;
		color: var(--ink);
		transition: transform var(--duration) var(--ease), border-color var(--duration) var(--ease);
		cursor: pointer;
	}
	.album__tile:hover {
		border-color: var(--accent-bright);
		transform: translateY(-4px);
	}
	.album__tile--coming { cursor: default; }
	.album__tile--coming:hover { transform: none; border-color: var(--line); }

	/* Solid color fills (when no cover image) */
	.fill-oxblood { background: linear-gradient(135deg, #7E2A24 0%, #4A1815 100%); }
	.fill-blue-deep { background: linear-gradient(135deg, #0F1E80 0%, #060B40 100%); }
	.fill-blue-bright { background: linear-gradient(135deg, #1E40FF 0%, #0F1E80 100%); }

	/* Cover image */
	.album__tile img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 600ms var(--ease-out), filter var(--duration) var(--ease);
		filter: saturate(0.85) contrast(1.05);
	}
	.album__tile:hover img {
		transform: scale(1.05);
		filter: saturate(1.1) contrast(1.1);
	}

	/* Dark gradient overlay for legibility */
	.album__tile::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0) 100%);
		z-index: 1;
		pointer-events: none;
	}
	.album__tile--coming::before {
		background: linear-gradient(to top, rgba(0,0,0,0.4), rgba(0,0,0,0.1));
	}

	/* Overlay text content */
	.album__overlay {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: var(--s-5) var(--s-5) var(--s-4);
		z-index: 2;
		color: var(--ink);
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.album__num {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.22em;
		color: var(--accent-bright);
		margin-bottom: var(--s-2);
	}
	.album__title {
		font-family: var(--font-display);
		font-size: clamp(20px, 2.4vw, 30px);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.01em;
	}
	.album__title--coming {
		font-weight: 500;
		color: var(--ink-muted);
		font-size: 18px;
	}
	.album__sub {
		margin-top: var(--s-2);
		font-size: 13px;
		color: var(--ink-secondary);
	}
	.album__year {
		margin-top: var(--s-2);
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.2em;
		color: var(--ink-muted);
		text-transform: uppercase;
	}

	/* Shrink overlay text on smaller tiles (sf, p1) */
	.area-sf .album__title,
	.area-p1 .album__title {
		font-size: clamp(18px, 1.8vw, 22px);
	}

	/* Responsive */
	@media (max-width: 900px) {
		.album {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: 280px 200px 220px 200px;
			grid-template-areas:
				"ash   ash"
				"otb   sf"
				"boat  p07"
				"p1    p2";
		}
	}
	@media (max-width: 600px) {
		.album {
			grid-template-columns: 1fr;
			grid-template-rows: repeat(7, 200px);
			grid-template-areas:
				"ash"
				"otb"
				"sf"
				"boat"
				"p07"
				"p1"
				"p2";
			gap: 8px;
		}
	}

	/* ---------- Tools Section ---------- */
	.tools-section {
		margin-top: var(--s-9);
		padding-top: var(--s-7);
		border-top: 1px solid var(--line);
	}
	.tools-section__head {
		margin-bottom: var(--s-5);
	}
	.tools-section__head .eyebrow {
		font-size: 13px;
		display: block;
		margin-bottom: var(--s-3);
	}
	.tools-section__title {
		font-family: var(--font-display);
		font-size: clamp(20px, 2vw, 26px);
		font-weight: 700;
		color: var(--ink);
		letter-spacing: -0.01em;
	}
	.tools-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 12px;
	}
	.tool-card {
		position: relative;
		display: block;
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--bg-soft);
		min-height: 240px;
		text-decoration: none;
		color: var(--ink);
		transition: transform var(--duration) var(--ease), border-color var(--duration) var(--ease);
		cursor: pointer;
	}
	.tool-card:hover {
		border-color: var(--accent-bright);
		transform: translateY(-4px);
	}
	.tool-card__cover {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
		filter: saturate(0.7) contrast(1.05) brightness(0.85);
		transition: filter var(--duration) var(--ease), transform 600ms var(--ease-out);
	}
	.tool-card:hover .tool-card__cover {
		filter: saturate(0.9) contrast(1.1) brightness(0.95);
		transform: scale(1.02);
	}
	.tool-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.55) 50%, rgba(0,0,0,0.85) 100%);
		z-index: 1;
		pointer-events: none;
	}
	.tool-card__overlay {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: var(--s-6);
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.tool-card__num {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.22em;
		color: var(--accent-bright);
		margin-bottom: var(--s-2);
	}
	.tool-card__title {
		font-family: var(--font-display);
		font-size: clamp(22px, 2.4vw, 30px);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.01em;
	}
	.tool-card__sub {
		margin-top: var(--s-2);
		font-size: 13px;
		color: var(--ink-secondary);
	}
	.tool-card__year {
		margin-top: var(--s-2);
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.2em;
		color: var(--ink-muted);
		text-transform: uppercase;
	}
</style>
