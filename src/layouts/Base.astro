---
import BaseHead from '../components/BaseHead.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	current?: string;
	pageNum?: string;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	current = '',
	pageNum = '',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<ClientRouter />
	</head>
	<body>
		<div class="shell">
			<Sidebar current={current} />
			<main class="content">
				<slot />
			</main>
		</div>

		<!-- Lightbox: opened by clicking thumbnails inside .project__concept, .project__docs, .project__engineering-img -->
		<div id="lightbox" class="lightbox" aria-hidden="true" role="dialog">
			<button class="lightbox__close" type="button" aria-label="关闭">×</button>
			<button class="lightbox__nav lightbox__prev" type="button" aria-label="上一张">‹</button>
			<button class="lightbox__nav lightbox__next" type="button" aria-label="下一张">›</button>
			<figure class="lightbox__figure">
				<img class="lightbox__img" alt="" />
				<figcaption class="lightbox__caption"></figcaption>
			</figure>
			<div class="lightbox__counter"></div>
		</div>

		<script>
			// Lightbox — groups thumbnails inside the same container, prev/next within group.
			function attachLightbox() {
				const lightbox = document.getElementById('lightbox');
				if (!lightbox) return;
				const img = lightbox.querySelector('.lightbox__img') as HTMLImageElement;
				const caption = lightbox.querySelector('.lightbox__caption') as HTMLElement;
				const counter = lightbox.querySelector('.lightbox__counter') as HTMLElement;
				const closeBtn = lightbox.querySelector('.lightbox__close') as HTMLButtonElement;
				const prevBtn = lightbox.querySelector('.lightbox__prev') as HTMLButtonElement;
				const nextBtn = lightbox.querySelector('.lightbox__next') as HTMLButtonElement;

				let group: { src: string; alt: string; caption: string }[] = [];
				let idx = 0;

				function show() {
					const it = group[idx];
					img.src = it.src;
					img.alt = it.alt;
					caption.textContent = it.caption;
					counter.textContent = group.length > 1 ? `${idx + 1} / ${group.length}` : '';
					prevBtn.style.display = group.length > 1 ? '' : 'none';
					nextBtn.style.display = group.length > 1 ? '' : 'none';
				}
				function open(g: typeof group, i: number) {
					group = g; idx = i;
					show();
					lightbox.classList.add('is-open');
					document.body.style.overflow = 'hidden';
				}
				function close() {
					lightbox.classList.remove('is-open');
					document.body.style.overflow = '';
				}
				const prev = () => { idx = (idx - 1 + group.length) % group.length; show(); };
				const next = () => { idx = (idx + 1) % group.length; show(); };

				closeBtn.onclick = close;
				prevBtn.onclick = prev;
				nextBtn.onclick = next;
				lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });

				const keyHandler = (e: KeyboardEvent) => {
					if (!lightbox.classList.contains('is-open')) return;
					if (e.key === 'Escape') close();
					else if (e.key === 'ArrowLeft') prev();
					else if (e.key === 'ArrowRight') next();
				};
				document.addEventListener('keydown', keyHandler);

				// Multi-image containers — each container is its own group
				['.project__concept', '.project__docs'].forEach((sel) => {
					document.querySelectorAll(sel).forEach((box) => {
						const links = Array.from(box.querySelectorAll<HTMLAnchorElement>('a'));
						const g = links.map((a) => {
							const i = a.querySelector('img');
							const cap = a.querySelector('.project__concept-item-cap, .project__doc-cap');
							return {
								src: a.getAttribute('href') || '',
								alt: (i && i.alt) || '',
								caption: (cap && cap.textContent) || '',
							};
						});
						links.forEach((a, n) => {
							a.addEventListener('click', (e) => { e.preventDefault(); open(g, n); });
						});
					});
				});

				// Single-image: engineering screenshot
				document.querySelectorAll<HTMLAnchorElement>('.project__engineering-img').forEach((a) => {
					const i = a.querySelector('img');
					const g = [{ src: a.getAttribute('href') || '', alt: (i && i.alt) || '', caption: '' }];
					a.addEventListener('click', (e) => { e.preventDefault(); open(g, 0); });
				});
			}
			document.addEventListener('astro:page-load', attachLightbox);
		</script>

		<script>
			// Parallax tile collage — depth-based drift with mouse position.
			// data-depth: 1 (foreground, subtle) / 2 (mid) / 3 (background, strong)
			function attachParallax() {
				const tiles = document.querySelectorAll<HTMLElement>('.tile');
				if (!tiles.length) return;
				const handler = (e: MouseEvent) => {
					const x = (e.clientX / window.innerWidth - 0.5) * 2;
					const y = (e.clientY / window.innerHeight - 0.5) * 2;
					tiles.forEach((tile) => {
						const depth = parseFloat(tile.dataset.depth || '2');
						const intensity = depth * 7;
						const baseRotate = parseFloat(tile.dataset.rotate || '0');
						const sway = x * 0.6;
						tile.style.transform = `translate(${x * intensity}px, ${y * intensity}px) rotate(${baseRotate + sway}deg)`;
					});
				};
				window.addEventListener('mousemove', handler);
				return () => window.removeEventListener('mousemove', handler);
			}
			document.addEventListener('astro:page-load', attachParallax);
		</script>
	</body>
</html>
